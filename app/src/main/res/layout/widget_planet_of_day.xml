<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="18dp"
    android:paddingVertical="14dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/widget_planet_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="14dp"
        android:contentDescription="@string/widget_label"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_label"
            android:textColor="#AEBF92"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/widget_planet_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#F5EAD8"
            android:textSize="20sp"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_empty" />

        <TextView
            android:id="@+id/widget_planet_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#DCD3C4"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_planet_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#A19786"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

</LinearLayout>
